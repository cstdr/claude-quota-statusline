# 服务商自动识别：依 ANTHROPIC_BASE_URL（kimi.com/moonshot → kimi，minimax → minimax）
# 强制覆盖（一般不用）：
# STATUSLINE_PROVIDER=kimi

# Kimi usages API endpoint（一般不用改；留作调试 / 自定义代理）
# KIMI_USAGES_URL=https://api.kimi.com/coding/v1/usages

# MiniMax Token Plan API endpoint（一般不用改；留作调试 / 自定义代理）
# MINIMAX_REMAINS_URL=https://www.minimaxi.com/v1/token_plan/remains

# API key —— 三选一：
#   ANTHROPIC_AUTH_TOKEN   : Anthropic 兼容 token（推荐，已在你的现有环境里，两家通用）
#   KIMI_API_KEY           : Kimi 专用 API key（provider=kimi 时的 fallback）
#   MINIMAX_API_KEY        : MiniMax 专用 API key（provider=minimax 时的 fallback）
#
# statusline 查找顺序：ANTHROPIC_AUTH_TOKEN > 各家专用 key
# 留空 = 让 statusline 跳过配额字段（优雅降级，5h/周 两段不显示）
KIMI_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_AUTH_TOKEN=
