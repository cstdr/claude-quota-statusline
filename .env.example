# MiniMax Token Plan API endpoint（一般不用改；留作调试 / 自定义代理）
# MINIMAX_REMAINS_URL=https://www.minimaxi.com/v1/token_plan/remains

# API key —— 二选一：
#   MINIMAX_API_KEY        : MiniMax 专用 API key
#   ANTHROPIC_AUTH_TOKEN   : Anthropic 兼容 token（推荐，已在你的现有环境里）
#
# statusline 查找顺序：ANTHROPIC_AUTH_TOKEN > MINIMAX_API_KEY
# 留空 = 让 statusline 跳过这一字段（优雅降级，已用百分比会显示为 0）
MINIMAX_API_KEY=
ANTHROPIC_AUTH_TOKEN=